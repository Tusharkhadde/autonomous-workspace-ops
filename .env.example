# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.

# PostgreSQL connection string (the Prisma schema uses provider = "postgresql").
# Neon, Supabase, or a local Postgres all work. Format only:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Coasty computer-use API key (agent provider). Get one at https://coasty.ai
COASTY_API_KEY=

# Coasty API base URL (leave as is unless Coasty tells you otherwise)
COASTY_BASE_URL=https://coasty.ai

# Optional: OpenAI key for the fallback planner
OPENAI_API_KEY=
